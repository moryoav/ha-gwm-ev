        "data_description": {
          "region": "必须选择账号的注册区域，而不是车辆当前所在位置。"
        }
      },
      "account": {
        "title": "登录 GWM",
        "description": "输入官方应用使用的账号信息。身份验证将直接连接所选 GWM 云。生成的设备身份和账号绑定认证状态会被私密保存以便重启恢复，并且不会出现在诊断信息中。",
        "data": {
          "country": "注册国家或地区",
          "authentication_method": "ANZ 身份验证方式",
          "account": "电子邮件、用户名或注册手机号",
          "password": "密码"
        },
        "data_description": {
          "country": "账号注册国家或地区的两字母代码。",
          "authentication_method": "澳大利亚和新西兰账号请使用当前应用登录；仅当此账号曾经可以使用已停用的加载项时，才选择旧版登录。",
          "account": "请使用与官方 GWM 应用相同的账号标识。",
          "password": "存储在 Home Assistant 配置条目中，用于账号绑定的重启恢复和重新认证；诊断信息中会将其隐藏。"
        }
      },
      "verification": {
        "title": "输入验证码",
        "description": "输入 GWM 发送的一次性验证码。验证码仅使用一次，绝不会存储。",
        "data": {
          "verification_code": "验证码"
        }
      },
      "session_reclaim": {
        "title": "允许 ANZ 会话登录",
        "description": "澳大利亚和新西兰账号只允许一个活动会话。继续操作可能会使官方应用退出登录。建议使用专门共享给车辆的账号。",
        "data": {
          "allow_session_reclaim": "我已了解并希望继续"
        }
      },
      "initialization": {
        "title": "重试中国服务初始化",
        "description": "GWM 登录已成功，但有 {failure_count} 个下游服务阶段未能初始化。请使用已保存的可恢复 G-App 会话重试，无需再次请求短信验证码。"
      },
      "reconfigure": {
        "title": "重新配置 GWM",
        "description": "请选择替换账号的区域。在更改当前设置前需要先完成身份验证。",
        "data": {
          "region": "云区域"
